import("//build/ohos.gni")

# The maintained probe is one .c file. Compile a generated copy as C++ for the token SDK.
copy("probe_cpp_source") {
  sources = [ "sleip_dhcp_stage2.c" ]
  outputs = [ "$target_gen_dir/sleip_dhcp_stage2.cpp" ]
}

ohos_executable("sleip_dhcp_stage2") {
  sanitize = {
    cfi = true  # Enable/disable control flow integrity detection
    boundary_sanitize = true  # Enable boundary san detection
    cfi_cross_dso = true  # Cross-SO CFI Checks
    integer_overflow = true  # Enable integer overflow detection
    ubsan = true  # Enable some Ubsan options
    cfi_vcall_icall_only = true
    debug = false
  }
  sources = [ "$target_gen_dir/sleip_dhcp_stage2.cpp" ]
  include_dirs = [ "../../interfaces/kits/c" ]
  deps = [ ":probe_cpp_source", "//foundation/communication/dhcp/frameworks/native:dhcp_sdk" ]
  external_deps = [
    "nearlink_service:nearlink_framework",
    "access_token:libaccesstoken_sdk",
    "access_token:libnativetoken",
    "access_token:libtoken_setproc",
  ]
  subsystem_name = "communication"
  part_name = "dhcp"
  install_enable = true
}
